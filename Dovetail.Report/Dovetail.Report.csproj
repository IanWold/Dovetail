<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Dovetail.Report</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dovetail-report</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackageId>Dovetail.Report</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ian Wold</Authors>
    <Description>Generates a static, offline-capable HTML report of the pipelines Dovetail finds in a project.</Description>
    <PackageProjectUrl>https://github.com/IanWold/Dovetail</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IanWold/Dovetail.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright (c) 2026 Ian Wold</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\mermaid.min.js" LogicalName="Dovetail.Report.Assets.mermaid.min.js" />
    <EmbeddedResource Include="Assets\pico.indigo.min.css" LogicalName="Dovetail.Report.Assets.pico.indigo.min.css" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dovetail\Dovetail.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
